generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum ReportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  RETRYING
}

enum ReportFormat {
  PDF
  XLSX
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String?
  memberships    Membership[]
  reportsCreated Report[]     @relation("ReportCreatedByUser")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Plan {
  id                   String   @id @default(cuid())
  name                 String   @unique
  monthlyReportLimit   Int?     // null = unlimited
  tenants              Tenant[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Tenant {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  planId      String?
  plan        Plan?        @relation(fields: [planId], references: [id], onDelete: SetNull)
  memberships Membership[]
  reports     Report[]
  transactions Transaction[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([planId])
}

model Membership {
  id        String         @id @default(cuid())
  userId    String
  tenantId  String
  role      MembershipRole @default(MEMBER)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
}

model Report {
  id              String       @id @default(cuid())
  tenantId        String
  title           String
  format          ReportFormat @default(PDF)
  periodDays      Int          @default(30)
  status          ReportStatus @default(QUEUED)
  outputUrl       String?
  outputPath      String?
  recordsProcessed Int?
  totalAmountCents Int?
  createdByUserId String?
  createdByUser   User?        @relation("ReportCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([tenantId, status])
  @@index([createdByUserId])
}

model Transaction {
  id           String   @id @default(cuid())
  tenantId     String
  customerName String
  category     String
  amountCents  Int
  currency     String   @default("USD")
  occurredAt   DateTime
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([tenantId, occurredAt])
  @@index([tenantId, category])
  @@index([tenantId, customerName])
}
