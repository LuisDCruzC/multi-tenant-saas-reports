generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum ReportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  RETRYING
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String?
  memberships    Membership[]
  reportsCreated Report[]     @relation("ReportCreatedByUser")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Tenant {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  memberships Membership[]
  reports     Report[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Membership {
  id        String         @id @default(cuid())
  userId    String
  tenantId  String
  role      MembershipRole @default(MEMBER)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
}

model Report {
  id              String       @id @default(cuid())
  tenantId        String
  title           String
  status          ReportStatus @default(QUEUED)
  outputUrl       String?
  createdByUserId String?
  createdByUser   User?        @relation("ReportCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([tenantId, status])
  @@index([createdByUserId])
}
